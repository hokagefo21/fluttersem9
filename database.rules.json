{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'email', 'phone', 'createdAt', 'pushRequestedAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100"
        },
        "email": {
          ".validate": "newData.isString() && newData.val() === auth.token.email"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length >= 10 && newData.val().length <= 20"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },
        "pushRequestedAt": {
          ".validate": "newData.isNumber()"
        },
        "fcmToken": {
          ".validate": "newData.isString() && newData.val().length <= 4096"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "registrationPush": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
